# ─────────────────────────────────────────────────────────────
# NL2SQL Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────

# Google Gemini API key (required for AI query generation)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── POSTGRESQL (optional — defaults shown) ────────────────────

# Database credentials (used by both postgres container and backend)
POSTGRES_USER=northwind
POSTGRES_PASSWORD=northwind
POSTGRES_DB=northwind

# ── FRONTEND (optional) ───────────────────────────────────────

# URL of the backend API as seen by the user's browser.
# If running locally with docker-compose defaults, this is correct.
# Change to your server's public IP/hostname for remote deployments.
REACT_APP_API_URL=http://localhost:8000
